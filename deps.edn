{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}

        ;; UI: cljfx for reactive JavaFX
        cljfx/cljfx {:mvn/version "1.7.22"}
        org.openjfx/javafx-controls {:mvn/version "24.0.2"}
        org.openjfx/javafx-fxml {:mvn/version "24.0.2"}
        org.openjfx/javafx-swing {:mvn/version "24.0.2"}
        org.openjfx/javafx-web {:mvn/version "24.0.2"}

        ;; Electric Clojure: web-based reactive UI
        com.hyperfiddle/electric {:mvn/version "v3-alpha-SNAPSHOT"}
        org.clojure/clojurescript {:mvn/version "1.11.121"}
        ring/ring {:mvn/version "1.11.0"}
        com.google.guava/guava {:mvn/version "33.3.1-jre"}

        ;; Validation: guardrails for >defn (when needed)
        com.fulcrologic/guardrails {:mvn/version "1.2.9"}

        ;; LLM integration
        genek/llm-clients {:local/root "../llm-clients"}
        org.clojure/data.json {:mvn/version "2.5.1"}
        hato/hato {:mvn/version "1.0.0"}

        ;; Dev tools
        org.clojure/tools.namespace {:mvn/version "1.5.0"}}

 :aliases
 {:dev {:extra-paths ["src-dev"]
        :extra-deps {ring/ring-jetty-adapter {:mvn/version "1.11.0"}
                     thheller/shadow-cljs {:mvn/version "2.26.2"
                                           :exclusions [org.clojure/clojurescript]}
                     io.github.clojure/tools.build {:mvn/version "0.9.6"
                                                    :exclusions [com.google.guava/guava
                                                                 org.slf4j/slf4j-nop]}}
        :jvm-opts ["-Dguardrails.enabled=true"]}

  :javafx {:main-opts ["-m" "chow.ui.app"]
           :jvm-opts ["-Dguardrails.enabled=true"]}

  ;; Electric Clojure server
  :electric {:main-opts ["-m" "dev"]}

  :prod {:extra-deps {com.google.javascript/closure-compiler-unshaded {:mvn/version "v20230802"}}}

  :test {:extra-paths ["test"]
         :jvm-opts ["-Dguardrails.enabled=true"]}

  ;; REPL for development
  :nrepl {:extra-deps {nrepl/nrepl {:mvn/version "1.0.0"}
                       cider/cider-nrepl {:mvn/version "0.45.0"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"]}}}


